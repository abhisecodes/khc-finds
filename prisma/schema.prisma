datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SEOPageType {
  COMPARISON
  GUIDE
  LIST
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  posts     BlogPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?    // Lucide icon name or emoji
  products    Product[]
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  description    String    // Short excerpt
  longDescription String   @db.Text // Markdown description / review
  price          Float
  originalPrice  Float?
  rating         Float     @default(0.0)
  trendingScore  Float     @default(0.0)
  affiliateLink  String
  imageUrl       String
  couponCode     String?
  isFeatured     Boolean   @default(false)
  isSponsored    Boolean   @default(false)
  viewsCount     Int       @default(0)
  clicksCount    Int       @default(0)
  publishedAt    DateTime? @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  tags           Tag[]
  clicks         Click[]
  reviews        Review[]
}

model AffiliateNetwork {
  id               String   @id @default(uuid())
  name             String   @unique
  prefix           String   @unique // e.g. "amzn", "travelpayouts"
  defaultUtmSource String   @default("khc_platform")
  defaultUtmMedium String   @default("affiliate")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Click {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
}

model Trend {
  id           String   @id @default(uuid())
  keyword      String   @unique
  searchVolume Int      @default(0)
  source       String   // e.g. "Google", "Reddit", "Amazon"
  score        Float    @default(0.0)
  isRising     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Review {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewerName String
  rating       Int      @default(5)
  comment      String   @db.Text
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text // Markdown content
  summary     String?
  imageUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime? @default(now())
  createdAt   DateTime  @db.Timestamp() @default(now())
  updatedAt   DateTime  @updatedAt

  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
}

model SEOPage {
  id             String      @id @default(uuid())
  title          String
  slug           String      @unique
  type           SEOPageType @default(GUIDE)
  targetKeywords String      // Comma-separated
  description    String?     @db.Text
  content        String      @db.Text // Markdown buying guide or comparison
  config         String?     @db.Text // JSON configuration (comparison criteria, layout, etc.)
  isPublished    Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  isSubscribed Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model ChatConversation {
  id        String        @id @default(uuid())
  userIp    String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String           // "user" or "model"
  content        String           @db.Text
  createdAt      DateTime         @default(now())
}
